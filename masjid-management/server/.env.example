PORT=5000
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://your-frontend.vercel.app

# Push notifications (optional - app runs fine without these, just no reminders sent)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the external daily-reminder scheduler must send as the x-cron-secret header
CRON_SECRET=change-me-to-a-long-random-string
