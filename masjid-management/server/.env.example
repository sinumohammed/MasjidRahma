PORT=5000
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://your-frontend.vercel.app

# Push notifications (optional - app runs fine without these, just no reminders sent)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the external daily-reminder scheduler must send as the x-cron-secret header
CRON_SECRET=change-me-to-a-long-random-string
# Read-only access for the AI assistant (/api/ai/*) - optional; unset, those endpoints answer 503.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MASJID_AI_TOKEN=
# The assistant chat for logged-in users (/api/assistant/*) - optional; unset, the chat is hidden.
# AI_ASK_URL: the AI service's ask endpoint; AI_ASK_KEY: this app's key there (npm run new-app-key -- masjid).
AI_ASK_URL=https://ai-engineer-api-jet.vercel.app/api/ask
AI_ASK_KEY=
